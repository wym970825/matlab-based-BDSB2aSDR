{
  "version": "0.1.6",
  "title": "BDS-3 B2a Software Receiver",
  "icon": "assets/icon.jpg",
  "tabs": [
    {
      "id": "probe",
      "label": "Probe 探针",
      "description": "捕获前 IF 探针：时域 / 频谱 / 直方图 / PB debug（不运行捕获与跟踪）。PB 图使用「脉冲消隐」Tab 参数。",
      "kind": "probe",
      "fields": [
        {"key": "probeDurationMs", "label": "探针时长 (ms)", "type": "number", "min": 1, "max": 500, "step": 1, "hint": "默认 100 ms，与 probeData 一致"},
        {"key": "EnablePB", "label": "探针中生成 PB debug 图", "type": "bool", "hint": "对应 pulseBlanker.f_mitigate；门限见「脉冲消隐」Tab"}
      ]
    },
    {
      "id": "data",
      "label": "数据 / IF",
      "description": "中频文件、采样与射频标定",
      "fields": [
        {"key": "filePath", "label": "IF 目录", "type": "text", "full": true},
        {"key": "fileName", "label": "IF 文件名", "type": "text", "full": true},
        {"key": "msToProcess", "label": "处理时长 (ms)", "type": "number", "min": 1000, "step": 1000},
        {"key": "numberOfChannels", "label": "通道数", "type": "number", "min": 1, "max": 24},
        {"key": "samplingFreq", "label": "采样率 (Hz)", "type": "number"},
        {"key": "IF", "label": "中频 IF (Hz)", "type": "number"},
        {"key": "dataType", "label": "数据类型", "type": "select", "options": ["int16", "int8"]},
        {"key": "fileType", "label": "文件类型", "type": "select", "options": [{"v": 1, "t": "实数"}, {"v": 2, "t": "IQ 交织"}]},
        {"key": "skipNumberOfBytes", "label": "跳过字节 skipNumberOfBytes", "type": "number", "min": 0, "step": 1},
        {"key": "IFBandwidth", "label": "IF 带宽 (Hz)", "type": "number"},
        {"key": "codeLength", "label": "码长 (chip)", "type": "number"},
        {"key": "codeFreqBasis", "label": "码率 (Hz)", "type": "number"},
        {"key": "carrFreqBasis", "label": "载波频率 (Hz)", "type": "number"},
        {"key": "startOffset", "label": "startOffset (ms)", "type": "number", "step": 0.001},
        {"key": "c", "label": "光速 c (m/s)", "type": "number"},
        {"key": "usrp.scaleK", "label": "USRP scaleK (dB)", "type": "number", "step": 0.01},
        {"key": "usrp.gain", "label": "USRP gain (dB)", "type": "number"}
      ]
    },
    {
      "id": "pb",
      "label": "脉冲消隐",
      "description": "Pulse blanker（DME 类脉冲干扰）",
      "fields": [
        {"key": "EnablePB", "label": "使能 PB", "type": "bool"},
        {"key": "Th_static_dBm", "label": "静态门限 (dBm)", "type": "number", "step": 0.1},
        {"key": "PB_settings.UseStatic", "label": "使用静态门限", "type": "bool"},
        {"key": "PB_settings.falseAlert", "label": "虚警率", "type": "number", "step": 1e-5},
        {"key": "PB_settings.Th_TTL", "label": "Th_TTL", "type": "number"},
        {"key": "PB_settings.debugplot", "label": "PB debug 图", "type": "bool"}
      ]
    },
    {
      "id": "acq",
      "label": "捕获",
      "description": "Acquisition 搜索网格与精捕获",
      "fields": [
        {"key": "skipAcquisition", "label": "跳过捕获", "type": "bool"},
        {"key": "acqSatelliteList", "label": "PRN 列表", "type": "text", "full": true, "hint": "24,38,39,41 或 1:60"},
        {"key": "acqSearchBand", "label": "搜索带宽单边 (Hz)", "type": "number"},
        {"key": "acqStep", "label": "多普勒步进 (Hz)", "type": "number"},
        {"key": "acqThreshold", "label": "捕获门限", "type": "number", "step": 0.1},
        {"key": "fineNoncoh", "label": "精捕获非相干 (ms)", "type": "number"},
        {"key": "fineCodeSearchHalfWinSamples", "label": "精码搜索半窗 (samples)", "type": "number"},
        {"key": "resamplingThreshold", "label": "重采样门限 (Hz)", "type": "number"},
        {"key": "resamplingflag", "label": "重采样标志", "type": "number", "min": 0, "max": 1}
      ]
    },
    {
      "id": "trk",
      "label": "跟踪环路",
      "description": "DLL / PLL / 载波辅助 / C/N0 / 时间参数",
      "fields": [
        {"key": "dllDampingRatio", "label": "DLL 阻尼比", "type": "number", "step": 0.001},
        {"key": "dllCorrelatorSpacing", "label": "相关器间距 (chip)", "type": "number", "step": 0.05},
        {"key": "dllNoiseBandwidth_pull", "label": "DLL Bn pull (Hz)", "type": "number"},
        {"key": "dllNoiseBandwidth_stab", "label": "DLL Bn stab (Hz)", "type": "number"},
        {"key": "pllOrder", "label": "PLL 阶数", "type": "number", "min": 2, "max": 3},
        {"key": "pllDampingRatio", "label": "PLL 阻尼比", "type": "number", "step": 0.001},
        {"key": "pllNoiseBandwidth_pull", "label": "PLL Bn pull (Hz)", "type": "number"},
        {"key": "pllNoiseBandwidth_stab", "label": "PLL Bn stab (Hz)", "type": "number"},
        {"key": "pllDampingRatio_pull", "label": "PLL 阻尼 pull", "type": "number", "step": 0.001},
        {"key": "pllDampingRatio_stab", "label": "PLL 阻尼 stab", "type": "number", "step": 0.001},
        {"key": "phaseDisType", "label": "鉴相类型 phaseDisType", "type": "number"},
        {"key": "phaseDisType_init", "label": "鉴相类型 INIT", "type": "number"},
        {"key": "filter_pullinMS", "label": "Pull-in 窗口 (ms)", "type": "number"},
        {"key": "trackInit_MS", "label": "INIT 时长 (ms)", "type": "number"},
        {"key": "reEstimateMS", "label": "Weil 重估间隔 (ms)", "type": "number"},
        {"key": "longCoh_ms", "label": "长相干 ms", "type": "number"},
        {"key": "intTime", "label": "积分时间 (s)", "type": "number", "step": 0.001},
        {"key": "pilotTRKflag", "label": "导频跟踪标志", "type": "number", "min": 0, "max": 1},
        {"key": "weilEstBuffLen", "label": "Weil 缓冲长度", "type": "number"},
        {"key": "weilConfTh", "label": "Weil 置信门限", "type": "number", "step": 0.1},
        {"key": "TrkCN0Th", "label": "失锁 C/N0 (dB-Hz)", "type": "number"},
        {"key": "CNo_Th", "label": "C/N0 门限 (dB-Hz)", "type": "number"},
        {"key": "CNoInterval", "label": "C/N0 间隔 (ms)", "type": "number"},
        {"key": "carrierAidCode", "label": "载波辅助码环", "type": "bool"},
        {"key": "carrierAidCodeMaxHz", "label": "码辅助限幅 (Hz)", "type": "number"},
        {"key": "REACQ_max", "label": "最大 REACQ 次数", "type": "number"},
        {"key": "max_reacqT", "label": "max_reacqT", "type": "number"},
        {"key": "useParfor", "label": "parfor 并行", "type": "bool"},
        {"key": "parMaxWorkers", "label": "workers (≤6)", "type": "number", "min": 1, "max": 6},
        {"key": "plotTracking", "label": "跟踪绘图", "type": "bool"}
      ]
    },
    {
      "id": "fll",
      "label": "FLL",
      "description": "FLL 辅助 PLL 参数",
      "fields": [
        {"key": "FLL.enable", "label": "FLL 使能", "type": "bool"},
        {"key": "FLL.aidingEnable", "label": "辅助 PLL", "type": "bool"},
        {"key": "FLL.useBpskFold", "label": "BPSK fold", "type": "bool"},
        {"key": "FLL.smoothAlpha", "label": "平滑 α", "type": "number", "step": 0.01},
        {"key": "FLL.maxCorrHz", "label": "maxCorr (Hz)", "type": "number"},
        {"key": "FLL.errThInitOn_Hz", "label": "INIT 开门限 (Hz)", "type": "number"},
        {"key": "FLL.errThInitOff_Hz", "label": "INIT 关门限 (Hz)", "type": "number"},
        {"key": "FLL.errThLongOn_Hz", "label": "LONG 开门限 (Hz)", "type": "number"},
        {"key": "FLL.errThLongOff_Hz", "label": "LONG 关门限 (Hz)", "type": "number"},
        {"key": "FLL.N_on", "label": "N_on", "type": "number"},
        {"key": "FLL.N_off", "label": "N_off", "type": "number"},
        {"key": "FLL.gainInit", "label": "gainInit", "type": "number", "step": 0.001},
        {"key": "FLL.gainLong", "label": "gainLong", "type": "number", "step": 0.001},
        {"key": "FLL.filtZeta", "label": "filtZeta", "type": "number", "step": 0.001},
        {"key": "FLL.BW_Init_Hz", "label": "BW_Init (Hz)", "type": "number"},
        {"key": "FLL.BW_Long_Hz", "label": "BW_Long (Hz)", "type": "number"},
        {"key": "FLLinitT", "label": "FLLinitT", "type": "number"}
      ]
    },
    {
      "id": "kf",
      "label": "载波 KF",
      "description": "可选载波卡尔曼（默认关闭）",
      "fields": [
        {"key": "KF.enable", "label": "KF 使能", "type": "bool"},
        {"key": "KF.enableFeedback", "label": "反馈使能", "type": "bool"},
        {"key": "KF.feedbackGain", "label": "反馈增益", "type": "number", "step": 0.01},
        {"key": "KF.qJerk", "label": "qJerk", "type": "number", "step": 0.01},
        {"key": "KF.RphiFloor_deg", "label": "RphiFloor (deg)", "type": "number"},
        {"key": "KF.RphiCeil", "label": "RphiCeil", "type": "number"},
        {"key": "KF.RomegaFloor_Hz", "label": "RomegaFloor (Hz)", "type": "number"},
        {"key": "KF.maxCorrHz", "label": "maxCorr (Hz)", "type": "number"},
        {"key": "KF.scintAdaptiveEnable", "label": "闪烁自适应", "type": "bool"},
        {"key": "KF.scintWarmup_ms", "label": "闪烁预热 (ms)", "type": "number"},
        {"key": "KF.rmsBeta", "label": "rmsBeta", "type": "number", "step": 0.01}
      ]
    },
    {
      "id": "scint",
      "label": "闪烁",
      "description": "Scintillation calculator",
      "fields": [
        {"key": "scint_updateMs", "label": "更新间隔 (ms)", "type": "number"},
        {"key": "scint_bufLen", "label": "缓冲长度", "type": "number"},
        {"key": "scint_fCutoff", "label": "截止频率", "type": "number", "step": 0.01}
      ]
    },
    {
      "id": "nav",
      "label": "定位",
      "description": "PVT / 加权 / RAIM / NMEA / 真值",
      "fields": [
        {"key": "doNavigation", "label": "运行定位", "type": "bool"},
        {"key": "navSolPeriod", "label": "历元间隔 (ms)", "type": "number"},
        {"key": "elevationMask", "label": "高度角掩码 (°)", "type": "number"},
        {"key": "useTropCorr", "label": "对流层改正", "type": "bool"},
        {"key": "truePosition.E", "label": "真值 E (m, NaN=均值)", "type": "number"},
        {"key": "truePosition.N", "label": "真值 N (m)", "type": "number"},
        {"key": "truePosition.U", "label": "真值 U (m)", "type": "number"},
        {"key": "lsWeight.enableElev", "label": "高度角加权", "type": "bool"},
        {"key": "lsWeight.enableCno", "label": "C/N0 加权", "type": "bool"},
        {"key": "lsWeight.elevExp", "label": "elevExp", "type": "number", "step": 0.1},
        {"key": "lsWeight.elFloorDeg", "label": "仰角下限 (°)", "type": "number"},
        {"key": "lsWeight.cnoRefDb", "label": "C/N0 参考 (dB-Hz)", "type": "number"},
        {"key": "lsWeight.wMin", "label": "权重下限", "type": "number", "step": 0.01},
        {"key": "lsWeight.wMax", "label": "权重上限", "type": "number", "step": 0.01},
        {"key": "raim.enable", "label": "RAIM 使能", "type": "bool"},
        {"key": "raim.enableFde1", "label": "FDE 单星", "type": "bool"},
        {"key": "raim.enableFde2", "label": "FDE 双星", "type": "bool"},
        {"key": "raim.alwaysSearch", "label": "总是搜索 FDE", "type": "bool"},
        {"key": "raim.maxRmsM", "label": "残差 RMS 门限 (m)", "type": "number"},
        {"key": "raim.maxResM", "label": "最大残差 (m)", "type": "number"},
        {"key": "navTrackMaxSpeedMps", "label": "航迹跳变门限 (m/s)", "type": "number"},
        {"key": "nmea.enable", "label": "NMEA 导出", "type": "bool"},
        {"key": "nmea.talkerId", "label": "Talker", "type": "select", "options": ["GB", "BD", "GN", "GP"]},
        {"key": "nmea.bdtMinusUtc", "label": "BDT−UTC (s)", "type": "number"},
        {"key": "nmea.quality", "label": "GGA quality", "type": "number", "min": 0, "max": 8},
        {"key": "nmea.geoidSepM", "label": "大地水准面差 (m)", "type": "number"},
        {"key": "nmea.fileName", "label": "NMEA 文件名", "type": "text"},
        {"key": "doNmea", "label": "本次写 NMEA", "type": "bool"}
      ]
    },
    {
      "id": "plot",
      "label": "显示 / 输出",
      "description": "定位后图与百度地图",
      "fields": [
        {"key": "doPlot", "label": "定位后绘图", "type": "bool"},
        {"key": "plotNavPost", "label": "ENU/DOP/地图", "type": "bool"},
        {"key": "plotNavLegacy", "label": "旧版 plotNavigation", "type": "bool"},
        {"key": "plotBaiduMap", "label": "百度地图", "type": "bool"},
        {"key": "doBaiduMap", "label": "本次打开百度", "type": "bool"}
      ]
    }
  ]
}
